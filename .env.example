# QuotePilot — copy to .env for local dev. Never commit a real .env.
PORT=3000
DATABASE_PATH=./data/quotepilot.db
SESSION_SECRET=change-me-to-a-long-random-string-in-production
NODE_ENV=development
# In production, set NODE_ENV=production and serve behind HTTPS.
# SESSION_SECRET must be a long random value, set via environment, never in the repo.
